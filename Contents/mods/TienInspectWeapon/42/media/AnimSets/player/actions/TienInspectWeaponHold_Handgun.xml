<?xml version="1.0" encoding="utf-8"?>
<!--
	The hold for pistols and revolvers.

	A variant of TienInspectWeaponHold.xml (read that file first): the same PerformingAction, plus the
	engine's own "Weapon" variable, which IsoGameCharacter sets from WeaponType.getWeaponType
	on every machine whenever the hands change - so remote players pick the same variant
	with no networking. AnimState.getAnimNodes takes the matching node with the most
	conditions, so this one wins over the generic TienInspectWeaponHold node, which stays as the
	one-handed clip and the fallback for anything else (knives, throwables).

	Weapon values (handgun) are WeaponType's; each is its own group of
	conditions, separated by OR (AnimCondition.pass).

	Bob_TienInspect_Handgun_Hold is built by scripts/anim/clips/inspect.py (kind "Handgun").
-->
<animNode>
	<m_Name>TienInspectWeaponHold_Handgun</m_Name>
	<m_AnimName>Bob_TienInspect_Handgun_Hold</m_AnimName>
	<m_Looped>true</m_Looped>
	<m_BlendTime>0.30</m_BlendTime>
	<m_SpeedScale>1.0</m_SpeedScale>
	<m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
	<m_Conditions x_name="645c8433-e32f-4ec9-947d-4a170194da9d">
		<m_Name>PerformingAction</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>TienInspectWeaponHold</m_Value>
	</m_Conditions>
	<m_Conditions x_name="596c73ff-dee2-4c1e-a36a-6cbd863a6b4e">
		<m_Name>Weapon</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>handgun</m_Value>
	</m_Conditions>
	<m_Transitions>
